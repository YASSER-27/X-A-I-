{
  "name": "xai-app",
  "productName": "XAi",
  "version": "1.3.0",
  "description": "XAi - Local AI Assistant",
  "author": {
    "name": "YASSER-27"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "bin": {
    "gbot": "cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && npm run obfuscate && electron-builder --win",
    "dist:portable": "npm run build && npm run obfuscate && electron-builder --win portable",
    "obfuscate": "npx javascript-obfuscator dist-electron --output dist-electron --compact true --string-array true --control-flow-flattening true"
  },
  "build": {
    "appId": "com.yasser27.xai",
    "productName": "XAi",
    "npmRebuild": false,
    "copyright": "Copyright (c) 2026 YASSER-27",
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "gguf",
        "name": "Local AI Model",
        "description": "GGUF AI Model for XAi",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "public/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "cpp",
        "to": "cpp",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      },
      {
        "from": "sound",
        "to": "dist/sound"
      },
      {
        "from": "supertonic-3",
        "to": "supertonic-3",
        "filter": [
          "**/*",
          "!.git/**"
        ]
      },
      {
        "from": "my_local_model",
        "to": "my_local_model",
        "filter": [
          "**/*",
          "!.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XAi",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": null,
      "menuCategory": "XAi",
      "installerLanguages": [
        "en_US",
        "ar"
      ],
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/archiver": "^7.0.0",
    "an-array-of-english-words": "^2.0.0",
    "archiver": "^7.0.1",
    "commander": "^14.0.3",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "simple-git": "^3.36.0",
    "streamdown": "^2.5.0",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "javascript-obfuscator": "^5.4.1",
    "sass": "^1.99.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
